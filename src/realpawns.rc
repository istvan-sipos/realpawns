/* PE VERSIONINFO resource for realpawns.dll. */
#include <winver.h>

#ifndef REALPAWNS_VER_NUM
#define REALPAWNS_VER_NUM 0,0,0,0
#endif
#ifndef REALPAWNS_VER_STR
#define REALPAWNS_VER_STR "dev"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    REALPAWNS_VER_NUM
 PRODUCTVERSION REALPAWNS_VER_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "Istvan Sipos"
            VALUE "FileDescription",  "Dragon's Dogma: Dark Arisen, a mod that lets official rift pawns keep their progress"
            VALUE "FileVersion",      REALPAWNS_VER_STR
            VALUE "InternalName",     "realpawns"
            VALUE "LegalCopyright",   "MIT License - see LICENSE"
            VALUE "OriginalFilename", "realpawns.dll"
            VALUE "ProductName",      "realpawns"
            VALUE "ProductVersion",   REALPAWNS_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
